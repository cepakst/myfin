{
  "name": "myfin",
  "version": "1.0.0",
  "private": true,
  "description": "Myfin – lokální aplikace pro přehled investic, výnosů a daní (Degiro, XTB)",
  "type": "module",
  "main": "dist/electron/main.js",
  "author": "cepakst",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/server/main.ts",
    "dev:web": "vite",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "esbuild src/server/main.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/server/main.js",
    "build:electron": "esbuild src/electron/main.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/electron/main.js",
    "start": "node dist/server/main.js",
    "electron": "npm run build && npm run build:electron && electron .",
    "dist:win": "npm run build && npm run build:electron && electron-builder --win nsis",
    "dist:mac": "npm run build && npm run build:electron && electron-builder --mac dmg zip --arm64 --x64",
    "icons": "tsx scripts/generate-icons.ts",
    "demo:generate": "tsx scripts/generate-demo.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test"
  },
  "build": {
    "appId": "cz.cepakst.myfin",
    "productName": "Myfin",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/web/**",
      "dist/electron/**",
      "demo/**",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.finance",
      "identity": null,
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "${productName} ${version}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Myfin"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.4",
    "@fastify/static": "^10.1.6",
    "csv-parse": "^7.0.3",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.7",
    "jszip": "^3.10.2",
    "yahoo-finance2": "^4.0.5"
  },
  "devDependencies": {
    "@mantine/core": "^9.7.3",
    "@mantine/dropzone": "^9.7.3",
    "@mantine/hooks": "^9.7.3",
    "@mantine/notifications": "^9.7.3",
    "@playwright/test": "^1.64.1",
    "@tabler/icons-react": "^3.49.0",
    "@tanstack/react-query": "^5.104.5",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "fast-formula-parser": "^1.0.19",
    "mantine-datatable": "^9.4.0",
    "postcss": "^8.5.31",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "electron@45.0.0": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.28.2": true
  }
}
